# API local del backend Laravel para desarrollo.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# La indexación pública falla cerrada hasta que 7F configure un origen HTTPS real.
VITE_PUBLIC_SITE_URL=
VITE_PUBLIC_INDEXING_ENABLED=false

