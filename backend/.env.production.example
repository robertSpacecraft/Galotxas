APP_NAME="Club Galotxes Monòver"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.galotxesmonover.es
FRONTEND_URL=https://galotxesmonover.es
TRUSTED_PROXIES=*
CORS_ALLOWED_ORIGINS=https://galotxesmonover.es

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=notificaciones@galotxesmonover.es
MAIL_FROM_NAME="Club Galotxes Monòver"

CONTACT_FORM_ENABLED=false
CONTACT_NOTIFICATION_ENABLED=false
CONTACT_NOTIFICATION_TO=info@galotxesmonover.es
CONTACT_NOTIFICATION_FROM=notificaciones@galotxesmonover.es
CONTACT_NOTIFICATION_REPLY_TO_MODE=requester
CONTACT_NOTIFICATION_MAILER=
CONTACT_RETENTION_MONTHS=12
CONTACT_ABUSE_HASH_RETENTION_DAYS=30

PUBLIC_IDENTITY_AUTHORIZATION_ENABLED=false
PUBLIC_IDENTITY_NOTIFICATION_ENABLED=false
PUBLIC_IDENTITY_CONFIRMATION_TTL_HOURS=48

SCHOOL_ENROLLMENT_ENABLED=false
SCHOOL_UNFORMALIZED_RETENTION_MONTHS=6
SCHOOL_STUDENT_RETENTION_YEARS=2

DEPLOYMENT_SCHEDULER_ENABLED=false
