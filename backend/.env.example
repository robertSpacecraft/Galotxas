APP_NAME=Galotxas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=galotxas
DB_USERNAME=galotxas
DB_PASSWORD=galotxas

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_FORM_ENABLED=false
CONTACT_NOTIFICATION_ENABLED=false
CONTACT_NOTIFICATION_TO=
CONTACT_NOTIFICATION_FROM=
CONTACT_NOTIFICATION_REPLY_TO_MODE=requester
CONTACT_NOTIFICATION_MAILER=
CONTACT_RETENTION_MONTHS=12
CONTACT_ABUSE_HASH_RETENTION_DAYS=30

PUBLIC_IDENTITY_AUTHORIZATION_ENABLED=false
PUBLIC_IDENTITY_NOTIFICATION_ENABLED=false
PUBLIC_IDENTITY_CONFIRMATION_TTL_HOURS=48

SCHOOL_ENROLLMENT_ENABLED=false
SCHOOL_UNFORMALIZED_RETENTION_MONTHS=6
SCHOOL_STUDENT_RETENTION_YEARS=2

VITE_APP_NAME="${APP_NAME}"
FRONTEND_URL=http://localhost:5173
