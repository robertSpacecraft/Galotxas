# MariaDB credentials dedicated to logical backups.
BACKUP_DB_HOST=
BACKUP_DB_PORT=3306
BACKUP_DB_DATABASE=
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=

# Private S3-compatible media bucket.
BACKUP_MEDIA_BUCKET=
BACKUP_MEDIA_ENDPOINT=
BACKUP_MEDIA_REGION=
BACKUP_MEDIA_ACCESS_KEY_ID=
BACKUP_MEDIA_SECRET_ACCESS_KEY=
BACKUP_MEDIA_USE_PATH_STYLE_ENDPOINT=false
BACKUP_MEDIA_REMOTE_NAME=media-production-source

# Project-owned Google Drive OAuth application and encrypted restic repository.
BACKUP_GDRIVE_CLIENT_ID=
BACKUP_GDRIVE_CLIENT_SECRET=
BACKUP_GDRIVE_TOKEN=
BACKUP_GDRIVE_REMOTE_NAME=gdrive-galotxes-backup
BACKUP_RESTIC_PASSWORD=
BACKUP_RESTIC_REPOSITORY=rclone:gdrive-galotxes-backup:galotxes-backup/production
BACKUP_RESTIC_HOST=galotxas-production-backup
BACKUP_RESTIC_TAG=galotxas-production

# Retention for automated snapshots with the configured host and tag.
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=12
